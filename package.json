{
  "name": "taskflow",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "next build",
    "start": "tsx scripts/dev.ts --start",
    "vercel-build": "tsx scripts/db.ts deploy && next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:seed-demo": "tsx scripts/db.ts seed-demo",
    "db:reset": "tsx scripts/db.ts reset",
    "digest": "tsx scripts/digest.ts",
    "deadlines": "tsx scripts/check-deadlines.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.11",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "file-type": "^22.1.1",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 0 * * 1-5"
    },
    {
      "path": "/api/cron/check-deadlines",
      "schedule": "5 16 * * *"
    }
  ]
}

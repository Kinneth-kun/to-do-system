# TaskFlow — copy to .env.local for local development. Never commit real credentials.
# On Vercel, set these under Project → Settings → Environment Variables.

# ── Database ─────────────────────────────────────────────────────────────────────────────
# Postgres connection string. On Vercel, connecting a Neon database from the Marketplace sets
# DATABASE_URL for you. Leave it unset locally and `npm run dev` runs an embedded Postgres
# (PGlite) with its data in .data/pglite — no install needed.
DATABASE_URL=

# ── Application ──────────────────────────────────────────────────────────────────────────
# "Today", "overdue" and "due soon" are decided in this timezone (Vercel servers run in UTC).
APP_TIMEZONE=Asia/Manila
# Minutes of inactivity before a session ends ("Keep me signed in" lasts 30 days).
SESSION_LIFETIME=120

# ── Administrator ────────────────────────────────────────────────────────────────────────
# Created (or updated) on every deploy and on `npm run dev` / `npm run db:seed`.
# The password is only written when ADMIN_PASSWORD is set.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Scheduled jobs (Vercel Cron) ─────────────────────────────────────────────────────────
# Vercel sends this as a Bearer token to /api/cron/*; requests without it are refused.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── Attachments (Vercel Blob) ────────────────────────────────────────────────────────────
# Set by connecting a Blob store to the project. Without it, files are stored in .data/uploads
# (local development only — Vercel's filesystem is not persistent).
BLOB_READ_WRITE_TOKEN=
# "private" (recommended) or "public" — must match how the Blob store was created.
BLOB_ACCESS=private

# ── AI briefings (optional) ──────────────────────────────────────────────────────────────
# Without a key the 08:00 digest still goes out, with a plain generated summary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_TIMEOUT=30
